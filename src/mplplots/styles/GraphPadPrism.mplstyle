axes.autolimit_mode: round_numbers
axes.labelsize: 12
axes.labelweight: bold
axes.linewidth: 1.5
axes.spines.right: False
axes.spines.top: False
axes.titlesize: 16
axes.titleweight: bold

errorbar.capsize: 3

figure.dpi: 300
figure.figsize: 4.5, 3
figure.frameon: False

# Matplotlib's default cursive fonts (used for \mathcal), plus DejaVu Sans, the font
# Matplotlib falls back to anyway, so that a missing cursive font does not warn.
font.cursive: Apple Chancery, Textile, Zapf Chancery, Sand, Script MT, Felipa, Comic Neue, Comic Sans MS, DejaVu Sans, cursive
# Arial is used whenever it is installed. Otherwise fall back, without warnings, to
# Helvetica or an Arial metric-compatible clone, and finally to DejaVu Sans, which
# ships with Matplotlib and therefore always resolves. To get Arial on a machine
# that lacks it, register the font files with mplplots.utils.add_custom_fonts().
font.sans-serif: Arial, Helvetica, Liberation Sans, Arimo, Nimbus Sans, DejaVu Sans, sans-serif
font.size: 14
font.weight: bold

legend.fontsize: 8
legend.frameon: False
legend.loc: upper right

lines.linewidth: 2

# "sans" resolves through font.sans-serif, so math uses the same font as the text
# (Arial when installed).
mathtext.bf: sans:bold
mathtext.bfit: sans:italic:bold
mathtext.fontset: custom
mathtext.it: sans:italic
mathtext.rm: sans
mathtext.sf: sans

savefig.bbox: tight

xtick.labelsize: 10
xtick.major.width: 1.5
xtick.minor.visible: True
xtick.minor.width: 1.5

ytick.labelsize: 10
ytick.major.width: 1.5
ytick.minor.visible: True
ytick.minor.width: 1.5
